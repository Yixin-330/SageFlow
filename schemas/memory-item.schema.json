{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sageflow.local/schemas/memory-item.schema.json",
  "title": "MemoryItem",
  "type": "object",
  "required": ["memory_id", "memory_tier", "memory_domain", "memory_kind", "user_id", "statement", "scope", "confidence", "salience", "evidence_event_ids", "valid_from", "last_confirmed_at", "status", "sensitivity", "version", "lineage_id"],
  "properties": {
    "memory_id": {"type": "string"},
    "memory_tier": {"enum": ["short_term", "long_term"]},
    "memory_domain": {"enum": ["user", "relational", "shared"]},
    "memory_kind": {"enum": ["episodic", "semantic", "procedural"]},
    "memory_type": {"enum": ["short_term", "semantic_preference", "episodic", "relationship", "procedural"], "deprecated": true},
    "user_id": {"type": "string"},
    "statement": {"type": "object", "required": ["subject", "predicate", "value"]},
    "scope": {"type": "object", "required": ["domain"], "properties": {
      "domain": {"type": "string"},
      "trips": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "sessions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "days": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "date"}},
      "entities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "situations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["field", "value"]}},
      "time_window": {"type": "object", "required": ["start", "end"], "properties": {
        "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}
      }}
    }},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "salience": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_event_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_trip_ids": {"type": "array", "items": {"type": "string"}},
    "promoted_from": {"type": "array", "items": {"type": "string"}},
    "promotion_id": {"type": "string"},
    "promotion_group_id": {"type": "string"},
    "promotion_policy_version": {"type": "string"},
    "promotion_generation": {"type": "integer", "minimum": 1},
    "generalized_scope": {"type": "object"},
    "promoted_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "last_confirmed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["active", "superseded", "expired"]},
    "sensitivity": {"enum": ["normal", "sensitive"]},
    "service_role": {"enum": ["hard_constraint", "commitment", "observation"]},
    "version": {"type": "integer", "minimum": 1},
    "lineage_id": {"type": "string"}
  },
  "additionalProperties": true
}
