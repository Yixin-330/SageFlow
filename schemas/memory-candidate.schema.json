{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sageflow.local/schemas/memory-candidate.schema.json",
  "title": "MemoryCandidate",
  "type": "object",
  "required": ["candidate_id", "statement", "memory_tier", "memory_domain", "memory_kind", "scope", "evidence_event_ids", "evidence_kind", "confidence", "salience", "retention", "sensitivity"],
  "properties": {
    "candidate_id": {"type": "string"},
    "statement": {"type": "object", "required": ["subject", "predicate", "value"]},
    "memory_tier": {"enum": ["short_term", "long_term"]},
    "memory_domain": {"enum": ["user", "relational", "shared"]},
    "memory_kind": {"enum": ["episodic", "semantic", "procedural"]},
    "proposed_type": {"enum": ["short_term", "semantic_preference", "episodic", "relationship", "procedural"], "deprecated": true},
    "scope": {"type": "object", "required": ["domain"]},
    "evidence_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_kind": {"enum": ["explicit_statement", "observed_behavior", "inference", "user_correction"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "salience": {"type": "number", "minimum": 0, "maximum": 1},
    "retention": {"enum": ["do_not_store", "current_trip", "short_lived", "long_term_candidate"]},
    "sensitivity": {"enum": ["normal", "sensitive"]},
    "evolution_hint": {
      "type": "object",
      "required": ["operation", "target_memory_id", "split_group_id"],
      "properties": {
        "operation": {"const": "SPLIT"},
        "target_memory_id": {"type": "string"},
        "split_group_id": {"type": "string"}
      }
    }
  }
}
