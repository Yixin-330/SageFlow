{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sageflow.local/schemas/decision-context.schema.json",
  "title": "DecisionContext",
  "type": "object",
  "required": ["trace_id", "user_id", "trip_id", "purpose", "permissions", "current_facts", "long_term", "current_trip", "other_short_term", "state", "state_source", "state_status", "matched_rules", "conflicts", "omitted", "complete", "mandatory_overflow_count"],
  "properties": {
    "trace_id": {"type": "string"},
    "user_id": {"type": "string"},
    "trip_id": {"type": "string"},
    "purpose": {"const": "decision"},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "current_facts": {"type": "object"},
    "long_term": {"type": "array"},
    "current_trip": {"type": "array"},
    "other_short_term": {"type": "array"},
    "state": {"type": ["object", "null"]},
    "state_source": {"enum": ["provided", "inferred"]},
    "state_status": {"type": "string"},
    "matched_rules": {"type": "array"},
    "conflicts": {"type": "array"},
    "omitted": {"type": "array"},
    "complete": {"type": "boolean"},
    "mandatory_overflow_count": {"type": "integer", "minimum": 0}
  }
}
