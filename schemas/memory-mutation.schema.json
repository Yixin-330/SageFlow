{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sageflow.local/schemas/memory-mutation.schema.json",
  "title": "MemoryMutation",
  "type": "object",
  "required": ["mutation_id", "operation", "target_memory_id", "evidence_event_ids", "occurred_at"],
  "properties": {
    "mutation_id": {"type": "string"},
    "operation": {"enum": ["CREATE", "REINFORCE", "WEAKEN", "SUPERSEDE", "SPLIT", "MERGE", "EXPIRE", "FLAG_CONFLICT", "NO_LONG_TERM_CHANGE", "ADJUST_FREQUENCY"]},
    "target_memory_id": {"type": ["string", "null"]},
    "evidence_event_ids": {"type": "array", "items": {"type": "string"}},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
