{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sageflow.local/schemas/promotion-decision.schema.json",
  "title": "PromotionDecision",
  "type": "object",
  "required": ["decision_id", "user_id", "group_id", "generation", "action", "reason_code", "reason_codes", "policy_version", "target_scope", "evidence_event_ids", "evidence_hash", "evaluated_at"],
  "properties": {
    "decision_id": {"type": "string"},
    "user_id": {"type": "string"},
    "group_id": {"type": "string"},
    "generation": {"type": "integer", "minimum": 1},
    "action": {"enum": ["wait", "promote", "needs_confirmation", "blocked_by_counter_evidence", "expire", "rejected_by_policy"]},
    "reason_code": {"type": "string"},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "policy_version": {"type": "string"},
    "target_scope": {"type": ["object", "null"]},
    "evidence_event_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_hash": {"type": "string"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "promotion_key": {"type": ["string", "null"]}
  }
}
